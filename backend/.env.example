# Turso Database Configuration
# For production: use your Turso database URL (e.g., libsql://your-db.turso.io)
# For local development: leave unset to use file:./local.db
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# JWT Configuration
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# AI credentials are encrypted before storage. The assessment worker defaults
# to 12 requests/minute for Gemini and OpenRouter to leave Free Tier headroom.
AI_SECRET_ENCRYPTION_KEY=your-separate-ai-encryption-secret
ASSESSMENT_AI_GEMINI_RPM=12
ASSESSMENT_AI_OPENROUTER_RPM=12
# Optional per-provider throttles. Keep these conservative on free API tiers.
ASSESSMENT_AI_OPENAI_RPM=12
ASSESSMENT_AI_ANTHROPIC_RPM=12
ASSESSMENT_AI_GROQ_RPM=12
ASSESSMENT_AI_NVIDIA_RPM=12

# Leave the Cloudflare Queue bridge in durable_db until its own canary passes.
ASSESSMENT_AI_QUEUE_DELIVERY_MODE=durable_db
# CLOUDFLARE_ASSESSMENT_QUEUE_PRODUCER_URL=https://<worker>/enqueue
# CLOUDFLARE_ASSESSMENT_QUEUE_SHARED_SECRET=<at-least-32-random-characters>

# Browser origins allowed to call the API. Separate multiple origins with commas.
CORS_ORIGIN=https://uetcodehub.xyz,https://www.uetcodehub.xyz

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# Project GitHub repository verification
# Use a token for the account students must add as collaborator.
PROJECT_REPOSITORY_GITHUB_TOKEN=github-token-for-oasis-uet
PROJECT_REPOSITORY_REQUIRED_COLLABORATOR=oasis-uet

# Labels generated R2 object keys by deployment environment.
DEPLOYMENT_ENVIRONMENT=production
